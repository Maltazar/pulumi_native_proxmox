# Example Pulumi dev configuration
# Copy this file to Pulumi.dev.yaml and update with your actual values
config:
  # Provider Configuration
  proxmox:endpoint: https://your-proxmox-server:8006/api2/json
  proxmox:username: root@pam
  proxmox:password:
    secure: your-password-here # Use `pulumi config set --secret proxmox:password` to set this securely
  proxmox:node: your-node-name
  proxmox:insecure: true
  
  # VM Configuration
  vm:template_id: "9000" # ID of your Proxmox template
  vm:cores: 2
  vm:memory: 4096
  vm:disk_size: 15G
  vm:network_bridge: vmbr0 # Your Proxmox network bridge
  vm:disk_storage: local-lvm # Your Proxmox storage
  vm:vlan_tag: "140" # Your network VLAN tag if needed
  
  # Cloud-init Configuration
  cloud_init:username: admin # Initial user for cloud-init
  cloud_init:ssh_public_key: /home/user/.ssh/id_rsa.pub # Path to your SSH public key
  cloud_init:ssh_private_key:
    secure: /home/user/.ssh/id_rsa # Use `pulumi config set --secret cloud_init:ssh_private_key` to set this securely
  
  # VM Group Configuration - Master Nodes
  master:count: 3
  master:vm_start_id: 800
  master:ip_range: 10.0.0.10-10.0.0.12
  master:gateway: 10.0.0.1
  
  # VM Group Configuration - Worker Nodes
  worker:count: 2
  worker:vm_start_id: 810
  worker:ip_range: 10.0.0.20-10.0.0.21
  worker:gateway: 10.0.0.1 